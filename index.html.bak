      },
      {
        "@type": "Person",
        "name": "Patrícia Sene de Almeida",
        "jobTitle": "Pesquisadora e Consultora Acadêmica",
        "sameAs": "http://lattes.cnpq.br/8231562884189188"
      }
    ],
    "sameAs": [
      "http://lattes.cnpq.br/1573161606387648",
      "http://lattes.cnpq.br/8231562884189188",
