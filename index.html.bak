    ],
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceType": "Atendimento Online via Google Meet"
    }
  }
  </script>

  <style>
    /* ===========================================
       TOKENS — PALETA STANFORD ENXUTA
       =========================================== */
    :root {
      --cardinal: #8C1515;
      --cardinal-hover: #A01D1D;
      --black: #2E2D29;
      --black-deep: #111111;
      --white: #FFFFFF;
      --bg-soft: #EAEAEA;
      --bg-warm: #F7F7F5;
      --text: #2E2D29;
      --muted: #5A5A56;
      --border: #D9D9D9;
      --border-light: #ECECEC;
      --cardinal-soft: rgba(140, 21, 21, 0.08);
      --max-line: 72ch; /* Linha ideal ~72 caracteres — princípio Stanford[reference:9] */
    }

    html { scroll-behavior: smooth; }
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      
      :focus-visible { outline: 2px solid var(--cardinal); outline-offset: 2px; }
      /* Stack tipográfico: Source Sans 3 primeiro, fallback system */
      font-family: "Source Sans 3", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--white);
      color: var(--text);
      line-height: 1.7;
      padding-bottom: 100px;
      -webkit-font-smoothing: antialiased;
      font-size: 1.0625rem; /* 17px base — legibilidade acadêmica */
    }

    /* Títulos em serif — Source Serif 4 primeiro */
    h1, h2, h3, .serif {
      font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.015em;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    /* ===========================================
       HEADER — DISCRETO E FUNCIONAL
       =========================================== */
    .header-float {
      position: fixed; top: 1rem; left: 0; right: 0; z-index: 100;
      padding: 0 1rem;
    }
    .header-inner {
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: 0.25rem;
      padding: 0.7rem 1.25rem;
      display: flex; align-items: center; justify-content: space-between;
      max-width: 1120px; margin: 0 auto;
      box-shadow: 0 2px 12px -4px rgba(46,45,41,0.08);
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: inherit; }
    .brand-icon {
      width: 40px; height: 40px; border-radius: 0.125rem;
      background: var(--cardinal); color: var(--white);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .brand-text { font-family: "Source Serif 4", Georgia, serif; font-weight: 700; color: var(--black); font-size: 0.95rem; line-height: 1.2; }
    .brand-sub { font-size: 0.68rem; color: var(--muted); font-weight: 400; letter-spacing: 0.03em; text-transform: uppercase; }

    .nav-desktop { display: none; gap: 2rem; font-size: 0.82rem; font-weight: 500; letter-spacing: 0.02em; }
    .nav-desktop a {
      color: var(--muted); text-decoration: none; transition: color 0.2s;
      padding: 0.25rem 0;
      border-bottom: 2px solid transparent;
    }
    .nav-desktop a:hover { color: var(--cardinal); border-bottom-color: var(--cardinal); }
   .nav-dropdown{position:relative;display:inline-block;}
   .nav-dropdown-content{position:absolute;top:100%;left:0;background:#fff;border:1px solid var(--border);border-top:3px solid var(--cardinal);min-width:300px;max-width:340px;padding:12px 16px;box-shadow:0 12px 28px -8px rgba(46,45,41,0.14);z-index:100;opacity:0;visibility:hidden;transition:opacity 0.2s ease,visibility 0.2s ease;}
   .nav-dropdown:hover .nav-dropdown-content,.nav-dropdown:focus-within .nav-dropdown-content{opacity:1;visibility:visible;}
   .nav-dropdown-item{padding:8px 0;margin-bottom:8px;display:flex;align-items:center;gap:8px;color:var(--black);}
   .nav-dropdown-item strong{font-weight:700;font-size:0.94rem;}
   .nav-dropdown-item span{font-size:0.81rem;color:var(--muted);line-height:1.4;}
   .nav-dropdown-item:hover{padding-top:0.75rem;}

    .btn-whatsapp {
      display: inline-flex; align-items: center; gap: 0.45rem;
      background: var(--cardinal); color: var(--white); font-weight: 700;
      padding: 0.55rem 1rem; border-radius: 0.25rem; text-decoration: none;
      font-size: 0.78rem; transition: background 0.2s;
      letter-spacing: 0.03em; text-transform: uppercase;
    }
    .btn-whatsapp:hover { background: var(--cardinal-hover); }

    .menu-btn { display: block; background: none; border: none; padding: 0.5rem; cursor: pointer; color: var(--black); }
    .menu-btn svg { width: 22px; height: 22px; }

    .mobile-menu {
      display: none;
      background: var(--white); border: 1px solid var(--border); border-radius: 0.25rem; padding: 0.75rem;
      max-width: 1120px; margin: 0.5rem auto 0;
      box-shadow: 0 8px 24px -6px rgba(46,45,41,0.12);
    }
    .mobile-menu.open { display: block; }
    .mobile-menu a {
      display: block; padding: 0.65rem 1rem; border-radius: 0.125rem;
      color: var(--text); text-decoration: none; font-weight: 500; font-size: 0.9rem;
    }
    .mobile-menu a:hover { background: var(--cardinal-soft); color: var(--cardinal); }

    @media (min-width: 768px) {
      .nav-desktop { display: flex; }
      .menu-btn { display: none; }
    }

    /* ===========================================
       HERO — DECLARAÇÃO EDITORIAL CENTRADA
       =========================================== */
    .hero {
      padding: 8rem 0 4.5rem;
      background: var(--white);
      border-bottom: 1px solid var(--border-light);
      text-align: center;
    }
    .hero-inner { max-width: 820px; margin: 0 auto; }
    .hero .kicker {
      display: inline-block;
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--cardinal);
      margin-bottom: 1.25rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--cardinal);
    }
    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      color: var(--black);
      max-width: 22ch;
      margin: 0 auto;
      line-height: 1.1;
    }
    .hero h1 span { color: var(--cardinal); }
    .hero .lead {
      font-size: clamp(1rem, 1.5vw, 1.2rem);
      color: var(--muted);
      max-width: var(--max-line);
      margin: 1.5rem auto 0;
      line-height: 1.65;
    }
    .hero-actions {
      display: flex; flex-wrap: wrap; gap: 0.75rem;
      justify-content: center; margin-top: 2rem;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--cardinal); color: var(--white); font-weight: 700;
      padding: 0.85rem 1.6rem; border-radius: 0.25rem; text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      font-size: 0.92rem; letter-spacing: 0.02em;
    }
    .btn-primary:hover { background: var(--cardinal-hover); transform: translateY(-1px); }
    .btn-outline {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: transparent; color: var(--black); font-weight: 700;
      padding: 0.85rem 1.6rem; border-radius: 0.25rem; text-decoration: none;
      border: 1.5px solid var(--black); transition: background 0.2s, color 0.2s;
      font-size: 0.92rem; letter-spacing: 0.02em;
    }
    .btn-outline:hover { background: var(--black); color: var(--white); }

    .hero-meta {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem;
      margin-top: 2rem; font-size: 0.78rem; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .hero-meta svg { width: 15px; height: 15px; vertical-align: middle; margin-right: 0.35rem; color: var(--cardinal); }

    /* ===========================================
       STATEMENT — BLOCO DE IMPACTO SERIF
       =========================================== */
    .statement {
      padding: 4rem 0;
      background: var(--bg-soft);
      border-bottom: 1px solid var(--border-light);
    }
    .statement-inner {
      max-width: 780px; margin: 0 auto; text-align: center;
    }
    .statement p {
      font-family: "Source Serif 4", Georgia, serif;
      font-size: clamp(1.3rem, 2.5vw, 1.75rem);
      line-height: 1.5;
      color: var(--black);
      font-weight: 400;
    }
    .statement p strong { color: var(--cardinal); font-weight: 700; }

    /* ===========================================
       SEÇÕES GERAIS — RITMO STANFORD
       =========================================== */
    section { padding: 4rem 0; }
    .section-head {
      text-align: center; max-width: 720px; margin: 0 auto 2.75rem;
    }
    .section-label {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--cardinal);
      margin-bottom: 0.75rem;
    }
    .section-label::before {
      content: ""; width: 22px; height: 2px; background: var(--cardinal);
    }
    .section-head h2 {
      font-size: clamp(1.75rem, 3.2vw, 2.5rem);
      color: var(--black);
    }
    .section-head p {
      color: var(--muted); margin-top: 0.85rem;
      max-width: var(--max-line); margin-left: auto; margin-right: auto;
    }

.grid-3 { display: grid; gap: 1.5rem; }
    @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
.grid-2 { display: grid; gap: 1.5rem; }
    @media (min-width: 768px) { .grid-2 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .grid-2 { grid-template-columns: repeat(2, 1fr); } }

    .card {
      position: relative;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 0.25rem;
      padding: 1.75rem;
      display: flex; flex-direction: column;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .card:hover { border-color: var(--cardinal); box-shadow: 0 4px 16px -6px rgba(140,21,21,0.12); }
    .card h3 { font-size: 1.1rem; margin-bottom: 0.65rem; color: var(--black); }
    .card p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; flex-grow: 1; }
    .grid-2-wide {
      grid-column: 1 / -1;
      max-width: 540px;
      margin: 0 auto;
    }

    /* Card destaque — black + borda cardinal */
    .card.destaque {
      background: var(--black);
      border-color: var(--black);
      border-top: 4px solid var(--cardinal);
    }
    .card.destaque h3 { color: var(--white); }
    .card.destaque p { color: #B8B7B3; }
    .card.destaque:hover { border-color: var(--cardinal); box-shadow: 0 8px 24px -6px rgba(46,45,41,0.30); }

    /* ===========================================
       FEATURES — LISTA COM CHECKMARKS
       =========================================== */
    .feature-list { list-style: none; margin-top: 1rem; }
    .feature-list li {
      display: flex; gap: 0.6rem; padding: 0.3rem 0;
      font-size: 0.85rem; color: var(--muted);
    }
    .feature-list li svg {
      width: 16px; height: 16px; flex-shrink: 0;
      color: var(--cardinal); margin-top: 0.2rem;
    }
    .destaque .feature-list li { color: #D1D0CB; }

    /* ===========================================
       STEPS — LINHA DO TEMPO
       =========================================== */
    .steps { display: grid; gap: 1.25rem; }
    @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, 1fr); } }
    .step {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 0.25rem;
      padding: 1.5rem;
      border-top: 3px solid var(--cardinal);
    }
    .step-num {
      font-family: "Source Serif 4", Georgia, serif;
      font-size: 2rem; font-weight: 800;
      color: var(--cardinal); line-height: 1;
    }
    .step h3 { font-size: 0.95rem; color: var(--black); margin: 0.75rem 0 0.35rem; }
    .step p { font-size: 0.82rem; color: var(--muted); }

    /* ===========================================
       ÉTICA — BLOCO DE DESTAQUE
       =========================================== */
    .etica-box {
      background: var(--bg-warm);
      border: 1px solid var(--border);
      border-left: 4px solid var(--cardinal);
      border-radius: 0.25rem;
      padding: 2rem;
      display: flex; gap: 1.5rem; align-items: flex-start;
    }
    @media (max-width: 640px) { .etica-box { flex-direction: column; } }
    .etica-box svg { width: 36px; height: 36px; flex-shrink: 0; color: var(--cardinal); }
    .etica-box h2 { font-size: 1.25rem; color: var(--black); margin-bottom: 0.5rem; }
    .etica-box p { font-size: 0.92rem; color: var(--muted); }
    .etica-box strong { color: var(--black); }

/* ===========================================
   CONSULTORAS — EQUIPE ACADÊMICA
   =========================================== */
.consultoras-grid {
  display: grid;
  gap: 2rem;
  max-width: 920px;
  margin: 0 auto;
}
@media (min-width: 768px) {
  .consultoras-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.perfil-card {
  background: var(--black);
  color: var(--white);
  border-radius: 0.25rem;
  padding: 2.25rem 2rem;
  box-shadow: 0 8px 24px -6px rgba(46, 45, 41, 0.20);
  border-top: 4px solid var(--cardinal);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.perfil-avatar {
  width: 136px;
  height: 136px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--cardinal);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  margin-bottom: 1.25rem;
  background: var(--cardinal);
  flex-shrink: 0;
}

.perfil-avatar picture {
  display: block;
  width: 100%;
  height: 100%;
}

.perfil-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  display: block;
}

.perfil-card h3 {
  font-size: 1.45rem;
  color: var(--white);
}

.perfil-card .role {
  color: #E8A0A0;
  font-size: 0.82rem;
  font-weight: 600;
  margin-top: 0.25rem;
}

.perfil-card ul {
  list-style: none;
  margin: 1.25rem 0 1.75rem;
  font-size: 0.88rem;
  color: #C8C7C3;
  text-align: left;
  width: 100%;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 1.25rem;
  flex-grow: 1;
}

.perfil-card li {
  display: flex;
  gap: 0.6rem;
  padding: 0.35rem 0;
}

.perfil-card li svg {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
  color: #E8A0A0;
  margin-top: 0.25rem;
}

.btn-lattes {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  background: var(--cardinal);
  color: var(--white);
  padding: 0.7rem 1rem;
  border-radius: 0.25rem;
  font-size: 0.78rem;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  transition: background 0.2s;
}

.btn-lattes:hover {
  background: var(--cardinal-hover);
}

.consultora-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem;
  margin-top: 2.5rem;
}

.consultora-links a {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 0.25rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--black);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.consultora-links a:hover {
  border-color: var(--cardinal);
  color: var(--cardinal);
}

    /* ===========================================
       FOOTER
       =========================================== */
    .footer-estatico {
      background: var(--black-deep);
      color: #A8A7A2;
      padding: 2.5rem 0;
      font-size: 0.82rem; text-align: center;
      border-top: 4px solid var(--cardinal);
    }
    .footer-estatico strong { color: var(--white); }

    .footer-flutuante {
      position: fixed; bottom: 1rem; left: 0; right: 0; z-index: 100;
      padding: 0 1rem; transition: transform 0.3s, opacity 0.3s;
    }
    .footer-flutuante-inner {
      max-width: 820px; margin: 0 auto;
      background: var(--black); backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--black-deep); border-radius: 0.25rem;
      padding: 0.7rem 1.2rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; box-shadow: 0 8px 24px -6px rgba(46,45,41,0.35);
      border-left: 4px solid var(--cardinal);
    }
    .footer-flutuante-text { color: var(--white); font-size: 0.82rem; font-weight: 600; }
    .footer-flutuante-text small { color: #B8B7B3; font-weight: 400; display: none; }
    @media (min-width: 640px) { .footer-flutuante-text small { display: block; } }
    .btn-fechar { background: none; border: none; color: #8A8985; cursor: pointer; padding: 0.25rem; display: flex; }
    .btn-fechar:hover { color: var(--white); }
    .btn-fechar svg { width: 18px; height: 18px; }
    .footer-flutuante.hidden { transform: translateY(120px); opacity: 0; pointer-events: none; }
    /* Focus Visível */
    :focus-visible { outline: 2px solid var(--cardinal); outline-offset: 2px; }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header-float">
    <div class="header-inner">
      <a href="#inicio" class="brand">
        <div class="brand-icon">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </a>
        <div>
          <div class="brand-text">Consultoria de Pesquisa</a>
          <div class="brand-sub">SCA Consultoria Acadêmica</a>
        </a>
      </a>

      <nav class="nav-desktop">
        Desafios
        Serviços
      
        
          Reestruturação Textual e Metodológica
          Leitura integral e revisão pré-banca
        
        <a href="/servicos/
          Orientação Acadêmica Individualizada
          Acompanhamento contínuo via Google Meet
        
        <a href="/servicos/
          Mentoria de Pós-Graduação e Bolsas
          <span>Mapeamento de programas e anteprojeto</span>
        </a>
      </a>
        <a href="#como-funciona">Como Funciona</a>
        <a href="#etica">Ética</a>
        <a href="#consultora">Consultoras</a>
      </nav>

