<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultoria de Pesquisa Acadêmica | Orientação Metodológica e Reestruturação de Textos</title>
  <meta name="description" content="Orientação acadêmica online via Google Meet, reestruturação metodológica de teses e dissertações e mapeamento de pós-graduação e bolsas. Agende seu diagnóstico com nossa equipe.">
  <link rel="canonical" href="https://consultoriadepesquisa.com.br/">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#8C1515">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">

  <!-- Open Graph -->
  <meta property="og:title" content="Consultoria de Pesquisa Acadêmica | SCA Consultoria">
  <meta property="og:description" content="Orientação individualizada para destravar sua tese, dissertação ou artigo. Mais de 10 anos de experiência acadêmica.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://consultoriadepesquisa.com.br/">
  <meta property="og:locale" content="pt_BR">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
